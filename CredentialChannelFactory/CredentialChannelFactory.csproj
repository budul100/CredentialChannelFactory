<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Version>3.3.0</Version>
		<FileVersion>$(Version)</FileVersion>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<AssemblyName>CredentialChannelFactory</AssemblyName>
		<Authors>budul100</Authors>
		<RepositoryUrl>https://github.com/budul100/CredentialChannelFactory</RepositoryUrl>
		<Description>Factory for creating of web service channels with credentials</Description>

		<PackageId>budul.CredentialChannelFactory</PackageId>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>webservice;soap;credentials;wcf;channel-factory</PackageTags>
		<PackageProjectUrl>https://www.nuget.org/packages/budul.CredentialChannelFactory</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<DebugType>portable</DebugType>
		<OutputType>Library</OutputType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<!-- No package by default -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<!-- Package for release only -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(Configuration)' == 'Release'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- net8.0 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
		<PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.5" />
	</ItemGroup>

	<!-- net9.0 (ServiceModel 8.1.x is the latest line without a net10 dependency chain) -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
		<PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.21" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.21" />
	</ItemGroup>

	<!-- net10.0 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
		<PackageReference Include="System.ServiceModel.Primitives" Version="10.0.652802" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CredentialChannelFactory.Tests" />
	</ItemGroup>

</Project>
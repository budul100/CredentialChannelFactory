<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>CredentialChannelFactory</AssemblyName>
		<AssemblyVersion>2.0.0</AssemblyVersion>
		<Authors>budul</Authors>
		<FileVersion>$(AssemblyVersion)</FileVersion>
		<DebugType>portable</DebugType>
		<Description>Factory for creating of web service channels with credentials</Description>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<OutputType>Library</OutputType>
		<PackageId>budul.CredentialChannelFactory</PackageId>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://www.nuget.org/packages/budul.CredentialChannelFactory</PackageProjectUrl>
		<PackageTags>WebService, SOAP, Credentials</PackageTags>
		<PackageReadmeFile>ReadMe.md</PackageReadmeFile>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryUrl>https://github.com/budul100/CredentialChannelFactory</RepositoryUrl>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
		<Version>$(AssemblyVersion)</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.8" />
		<PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
		<PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../ReadMe.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

</Project>
